{
  "name": "human-dispatch",
  "version": "0.1.18",
  "description": "人类调度：让 AI 安排、提醒和监督你的工作",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node tools/check.cjs",
    "pack:offline": "node tools/package-portable.cjs",
    "pack": "npm run check && electron-builder --dir",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dev": "node tools/dev.cjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "test": "node --test backend/test/*.test.cjs",
    "test:desktop": "node tools/run-desktop-test.cjs",
    "test:conversation": "node tools/run-conversation-test.cjs",
    "test:chat-ui": "node tools/run-chat-ui-test.cjs",
    "test:stickers": "node tools/run-stickers-test.cjs",
    "test:online-stickers": "node tools/run-online-stickers-test.cjs",
    "test:lively-stickers": "node tools/run-lively-stickers-test.cjs",
    "test:task-settings": "node tools/run-task-settings-test.cjs",
    "test:task-list": "node tools/run-task-list-test.cjs",
    "test:conversation-lifecycle": "node tools/run-conversation-lifecycle-test.cjs",
    "dist:installer": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.human-dispatch.desktop",
    "productName": "人类调度",
    "artifactName": "人类调度-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!assets/*.mp3",
      "frontend/**/*",
      "backend/*.cjs",
      "!frontend/.env",
      "!frontend/.env.*",
      "frontend/.env.example"
    ],
    "extraResources": [
      {
        "from": "assets/notification.mp3",
        "to": "assets/notification.mp3"
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "include": "tools/installer.nsh",
      "artifactName": "Humancall-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "人类调度"
    }
  },
  "devDependencies": {
    "electron": "28.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
